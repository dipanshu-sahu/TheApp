# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Backend REST API base URL
API_BASE_URL=http://YOUR_SERVER_IP:PORT

# MQTT broker URL used during device provisioning
MQTT_BROKER_URL=http://YOUR_MQTT_BROKER_IP:PORT

# Device SoftAP address during provisioning (usually fixed by hardware)
DEVICE_AP_HOST=192.168.10.1
DEVICE_AP_PORT=3333

# MMKV encryption key — use a strong random string in production
MMKV_ENCRYPTION_KEY=replace-with-a-strong-random-key
